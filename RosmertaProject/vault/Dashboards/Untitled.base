views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasProperty("FileType")
        - FileType == "🚥 Dev Item"
        - file.folder != "vault/templates"
    order:
      - file.name
      - Cycle
      - Priority
      - DevStatus
      - Dev Status
      - DependsOn
      - Completed
      - tags
      - Version
    columnSize:
      note.Completed: 33
      note.tags: 108
